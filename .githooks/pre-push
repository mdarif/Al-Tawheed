#!/usr/bin/env bash
# Local pre-push gate, run on every `git push`: analyze, unit/widget tests,
# the format check (`make format-check`, same directories as the Makefile) and
# the tool/ Python tests. It does not run the on-device or release gates.
set -euo pipefail

echo ""
echo "┌─────────────────────────────────────┐"
echo "│  Pre-push checks                    │"
echo "└─────────────────────────────────────┘"

echo ""
echo "▶  flutter analyze --fatal-warnings"
flutter analyze --fatal-warnings

echo ""
echo "▶  flutter test"
flutter test --reporter=expanded

echo ""
echo "▶  make format-check"
make format-check

echo ""
echo "▶  python3 -m unittest discover -s test/tool"
python3 -m unittest discover -s test/tool

echo ""
echo "✓  All checks passed — push allowed."
